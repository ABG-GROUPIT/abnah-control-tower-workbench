# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/.env.example
!/supabase/.env.example
!/project-pack/zoho-control-tower/.env.example
!/project-pack/zoho-control-tower/portal_runtime/supabase/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/pages-dist/
/public/data/control-tower-portal-demo.json
/github-pages/public/data/control-tower-portal-demo.json
/.wrangler/
/outputs/
/work/
__pycache__/
*.py[cod]

# Local operational evidence and transient development servers
/tools/local_data_auditor/
/tools/local-auditor/input/*
!/tools/local-auditor/input/README.md
/tools/local-auditor/output/*
!/tools/local-auditor/output/.gitkeep
/.codex-dev-*.log
/.codex-dev-*.pid
/.preview-pages.*.log
/.preview-pages.pid
/config/zoho-reference-links.local.json
/portal-handoff/*.local.json
/portal-handoff/*.generated.json
