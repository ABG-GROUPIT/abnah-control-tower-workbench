# Register a Zoho server-based OAuth client and keep these values server-side.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_SESSION_SECRET=

# ABG-GIT-Workspace shown in the current Zoho Analytics URL.
ZOHO_ALLOWED_WORKSPACE_ID=333330000004099001

# Optional. When omitted, every verified member of the allowed workspace can
# maintain the shared URL handoff. Add comma-separated emails to restrict it.
ZOHO_PORTAL_ADMIN_EMAILS=

# India data-center defaults. Override only if the Zoho account moves regions.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_ANALYTICS_API_BASE_URL=https://analyticsapi.zoho.in
ZOHO_PROFILE_BASE_URL=https://profile.zoho.in

# Optional exact callback override. Otherwise the app uses:
# <current-origin>/api/zoho-auth/callback
ZOHO_OAUTH_REDIRECT_URI=
