{
  "name": "abnah-schema-atlas",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "python scripts/build_project_pack_index.py && vite build --config vite.pages.config.ts && python scripts/package_github_pages.py && python scripts/validate_pages_artifact.py",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "start": "wrangler dev --config dist/server/wrangler.json --show-interactive-dev-session=false",
    "data:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh_atlas.ps1",
    "data:workspace": "py -3 scripts/build_workspace_data.py",
    "data:validate": "py -3 scripts/validate_atlas_data.py && py -3 scripts/validate_workspace_data.py && py -3 scripts/validate_control_tower.py && py -3 scripts/validate_schema_privacy.py && py -3 scripts/validate_project_pack.py",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  },
  "type": "module"
}
