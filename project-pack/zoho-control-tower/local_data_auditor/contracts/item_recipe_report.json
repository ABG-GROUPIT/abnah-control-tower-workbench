{
  "contract_version": "1.0.0",
  "report_id": "p1.item_recipe.detail",
  "display_name": "Item Recipe Report",
  "canonical_filename_prefix": "item_recipe",
  "workbench": {
    "target_report_id": "report:p1_main:06_misc:18_item_recipe_report",
    "blueprint_path": "schema-pack/source/report_structures/p1_main/06_misc/18_item_recipe_report.json",
    "variant": "detail",
    "layout_kind": "flat"
  },
  "filename_regexes": ["(?i).*item[ _-]*recipe[ _-]*report.*\\.csv$"],
  "schema_status": "validated_from_populated_uat_csv_with_hierarchical_parent_rows",
  "grain": "one normalized row per menu item and recipe ingredient, inherited from grouped parent rows",
  "filter_profile": {
    "detail_level": "menu item to ingredient",
    "include_all_active_items": true
  },
  "max_trailing_empty_fields": 1,
  "header_search_rows": 5,
  "auxiliary_row_widths": [1, 4],
  "row_adapter": {
    "type": "hierarchical_forward_fill",
    "context_positions": [1, 2],
    "detail_positions": [3, 4, 5, 6, 7],
    "skip_rows_without_detail": true
  },
  "expected_header": [
    "Item Type", "Item Number", "Item Name", "Recipe Item Type", "Qty",
    "Recipe Unit", "Ingredient Code", "Ingredient Name"
  ],
  "row_columns": [
    {"name": "menu_item_type", "type": "text"},
    {"name": "menu_item_number", "type": "text", "required": true},
    {"name": "menu_item_name", "type": "text", "required": true},
    {"name": "recipe_item_type", "type": "text"},
    {"name": "recipe_qty_per_menu_unit", "type": "decimal", "required": true},
    {"name": "recipe_unit", "type": "text", "required": true},
    {"name": "ingredient_code", "type": "text", "required": true},
    {"name": "ingredient_name", "type": "text", "required": true}
  ],
  "rules": [
    {
      "id": "recipe_qty_nonnegative",
      "type": "nonnegative",
      "field": "recipe_qty_per_menu_unit",
      "severity": "error",
      "message": "Recipe quantity cannot be negative."
    }
  ]
}
