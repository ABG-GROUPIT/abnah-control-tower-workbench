# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to deployed
# Edge Functions. Add them only when serving the function locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Zoho server-based OAuth client. These values stay in Supabase secrets.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_ALLOWED_WORKSPACE_ID=333330000004099001
ZOHO_TOKEN_ENCRYPTION_KEY=

# GitHub Pages is the only frontend origin and OAuth return target.
PORTAL_ALLOWED_ORIGIN=https://abg-groupit.github.io
PORTAL_RETURN_URL=https://abg-groupit.github.io/abnah-control-tower-workbench/portal/

# Required comma-separated administrators for the hybrid visual handoff.
# When blank, no signed-in user can modify the shared Zoho view URLs.
ZOHO_PORTAL_ADMIN_EMAILS=

# India data-centre defaults. Change only if ABNAH's Zoho tenant moves.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_ANALYTICS_API_BASE_URL=https://analyticsapi.zoho.in
ZOHO_PROFILE_BASE_URL=https://profile.zoho.in

# Optional exact override. The normal callback is:
# https://<PROJECT_REF>.supabase.co/functions/v1/abnah-portal/auth/callback
ZOHO_OAUTH_REDIRECT_URI=
